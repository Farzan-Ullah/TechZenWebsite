PORT=5000
NODE_ENV=development
MONGO_DB=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/TechZen?appName=Cluster0
JWT_ACCESS_TOKEN_SECRET=your_jwt_access_secret_here
JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax

# Optional Cloudinary configuration for CMS image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
